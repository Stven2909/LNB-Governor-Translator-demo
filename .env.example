# =====================================================================
# Worker LNB - Pagaduria Digital
# EJEMPLO de variables de entorno para la VM / Cloud Run.
#
# USO: copiar a .env y completar.  cp .env.example .env
# .env esta en .gitignore: NUNCA se commitea. Solo se versiona este archivo.
#
# REGLA DE SECRETOS: este archivo guarda SIEMPRE REFERENCIAS (nombres de
# variable) y jamas valores. Los valores reales de REPORT_API_TOKEN y
# SYBASE_PASSWORD viven en Secret Manager; las credenciales de Google viven
# en un archivo fuera del repositorio apuntado por GOOGLE_APPLICATION_CREDENTIALS.
#
# Todo lo de aqui se inyecta sin recompilar (application.properties + @ConfigurationProperties).
# =====================================================================

# ----------------------------- Runtime --------------------------------
PORT=8080
# vacio = perfil mock (corre sin dependencias externas)
# dev-vertex = Governor real contra Vertex AI
SPRING_PROFILES_ACTIVE=
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_WORKER=INFO
# Zona horaria de los logs y evidencias. Confirmar con JD (Cloud Run arranca en UTC).
#TZ=America/Bogota

# ----------------------------- Modos ----------------------------------
# Defaults del perfil mock: mock en todo, ejecutable sin configurar nada.
APP_GOVERNOR_MODE=MOCK
APP_INGEST_MODE=PUSH
APP_STORE_MODE=MEMORY
APP_REPORTER_MODE=MOCK

# -------------------------- Vertex AI ---------------------------------
# Obligatorio si APP_GOVERNOR_MODE=VERTEX (DeploymentConfigValidator falla al arrancar).
APP_VERTEX_PROJECT_ID=proy-comercial-dev-lnb
APP_VERTEX_REGION=us-central1
APP_VERTEX_MODEL=gemini-2.5-flash
APP_VERTEX_PROMPT_VERSION=governor-v0.1
APP_VERTEX_TIMEOUT=30s
APP_VERTEX_MAX_ATTEMPTS=3
APP_VERTEX_BACKOFF_BASE=500ms
APP_VERTEX_MAX_INPUT_CHARS=65536
APP_VERTEX_TEMPERATURE=0.0

# ------------------- Reporte a la API de LNB ---------------------------
# Obligatorio si APP_REPORTER_MODE=HTTP (DeploymentConfigValidator falla al arrancar).
APP_REPORT_BASE_URL=
APP_REPORT_RESULT_PATH=/api/v1/integration/payment-committed
APP_REPORT_TIMEOUT=10s
APP_REPORT_IDEMPOTENCY_HEADER=Idempotency-Key
# Nombre de la variable de entorno que contiene el token. NO va el token aqui.
APP_REPORT_TOKEN_ENV_VAR=REPORT_API_TOKEN
#REPORT_API_TOKEN=<valor en Secret Manager, nunca en este archivo>

# ------------------------ Sybase por JDBC ------------------------------
# Obligatorio si APP_STORE_MODE=JDBC (DeploymentConfigValidator falla al arrancar).
# TODO(jConnect): driver pendiente de Alex; sin el JAR la imagen no conecta.
APP_JDBC_URL=
APP_JDBC_DRIVER=com.sybase.jdbc4.jdbc.SybDriver
APP_JDBC_USERNAME=
# Nombre de la variable que contiene la clave. NO va la clave aqui.
APP_JDBC_PASSWORD_ENV_VAR=SYBASE_PASSWORD
#SYBASE_PASSWORD=<valor en Secret Manager, nunca en este archivo>
APP_JDBC_TIMEOUT=15s
APP_JDBC_MAX_ATTEMPTS=3

# ----------------------------- Pub/Sub ---------------------------------
# Obligatorio si APP_INGEST_MODE=PULL (DeploymentConfigValidator falla al arrancar).
APP_PUBSUB_PROJECT_ID=
APP_PUBSUB_SUBSCRIPTION_ID=
APP_PUBSUB_DLQ_TOPIC_ID=
APP_PUBSUB_ACK_DEADLINE=60s
APP_PUBSUB_MAX_DELIVERY_ATTEMPTS=5

# ------------------ Limites (revision de Carlos) ------------------------
# Pre-commit: intentos del pipeline para un error no previsto antes del commit.
# Al agotarlos -> QUARANTINE_TECHNICAL con ACK.
APP_MAX_UNKNOWN_RETRIES=3
# Post-commit: redelivery de Pub/Sub para un fallo de reporte con el pago ya
# confirmado. Al agotarlos -> reportStatus=BLOCKED + manualActionRequired=true.
# Se cuentan con deliveryAttempt, no con attemptCount, para no alterar el
# attemptNumber del reporte.
APP_MAX_REPORT_ATTEMPTS=5

# ------------------------ Credenciales (fuera del repo) ------------------
# Ruta del JSON de cuenta de servicio. El archivo vive fuera del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=
